# Copie este arquivo para .env e substitua os valores abaixo.
# Nunca envie o arquivo .env ao GitHub.
RABBITMQ_USER=conexao
RABBITMQ_PASSWORD=SUBSTITUA_POR_SENHA_FORTE
# Use uma chave aleatoria de 32 bytes ou mais; por exemplo: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_DE_64_CARACTERES
